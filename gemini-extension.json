{
  "name": "2captcha-mcp",
  "version": "0.1.3",
  "description": "Web search, scraping past anti-bot walls, marketplace parsing, browser automation and CAPTCHA solving via 2Captcha.",
  "mcpServers": {
    "2captcha": {
      "command": "npx",
      "args": ["-y", "@2captcha/mcp"],
      "env": { "API_TOKEN": "$API_TOKEN" }
    }
  },
  "settings": [
    {
      "name": "2Captcha API key",
      "description": "Your 2Captcha API key, from https://2captcha.com/setting",
      "envVar": "API_TOKEN",
      "sensitive": true
    }
  ]
}
